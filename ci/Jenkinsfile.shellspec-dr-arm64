// =============================================================================
// Jenkinsfile.shellspec-dr-arm64  —  Scenario B: DR Restore (arm64 / Pi 5)
//
// Clones TEMPLATE_ID (default 9003 = latest Raspberry Pi OS Lite arm64, the real
// Pi 5 base OS; 9002 = vanilla Debian Trixie arm64 baseline). Neither has PVE/PBS.
// Full DR scenario tested end-to-end:
//   Step 0: installs pxvirt (PVE), configures bridge, reboots
//   Step 1+: installs PBS (pipbs), rclone, restic, resticprofile
//   Then: restores PBS datastore from GDrive, restores LXC from PBS
//
// Prerequisite: proxmox-ci-backup-arm64 must have run at least once to
// populate bu/ci-restore-test-arm64 in Google Drive.
//
// NOTE: arm64 is fully emulated (no KVM), expect 3-5x longer build times.
// =============================================================================

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        // 9003 = latest Raspberry Pi OS Lite arm64, swapped boot layer only
        //        (ci/build-pios-disk.sh) — the real Pi 5 base OS. Default since
        //        2026-11-21 (first full Pi OS DR run: dr-arm64 #65, 7/7 passed).
        // 9002 = Debian trixie arm64 cloud image — kept as a comparison baseline.
        string(name: 'TEMPLATE_ID', defaultValue: '9003', description: 'arm64 template VM to clone (9003 Pi OS Lite = default, 9002 Debian baseline)')
        // pxvirt = community PVE port (the cabin today); official = Proxmox arm64 (PVE 9.2+). PBS is pipbs either way.
        choice(name: 'PVE_ARM64_SOURCE', choices: ['pxvirt', 'official'], description: 'Where restore-1-install.sh installs PVE from on arm64')
    }

    triggers {
        cron('H 19 * * 0')  // 19:xx UTC = 21:xx CEST — after ci-backup-arm64 (H 18) is done
    }

    environment {
        VM_ID         = "9${String.format('%02d', (env.BUILD_NUMBER.toInteger() % 100) + 50)}"
        VM_IP         = "192.168.0.252"
        PVE_HOST      = "192.168.0.200"
        SSH_OPTS      = "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o ConnectTimeout=5 -i /var/lib/jenkins/.ssh/id_ed25519"
        SCRIPTS_DIR   = "/opt/proxmox-restore"
        GDRIVE_REPO   = "rclone:gdrive:bu/ci-restore-test-arm64"
        RESTIC_PW     = "/etc/resticprofile/restic-password"
    }

    stages {

        stage('Run') {
            options { lock('ci-vm-arm64') }
            stages {

        stage('Clone VM') {
            steps {
                echo "Cloning arm64 template ${params.TEMPLATE_ID} -> VM ${VM_ID} (${env.BUILD_TAG})"
                sh """
                    ssh ${SSH_OPTS} root@${PVE_HOST} \
                        "qm clone ${params.TEMPLATE_ID} ${VM_ID} --name restore-ci-arm64 --full 1"
                    ssh ${SSH_OPTS} root@${PVE_HOST} \
                        "qm resize ${VM_ID} scsi0 32G"
                """
            }
        }

        stage('Start VM + wait for SSH') {
            steps {
                sh "ssh ${SSH_OPTS} root@${PVE_HOST} 'qm start ${VM_ID}'"
                echo "Waiting for SSH at ${VM_IP} (first boot — max 600s: the golden image starts PVE/PBS services under full emulation)..."
                sh """
                    for i in \$(seq 1 120); do
                        ssh ${SSH_OPTS} root@${VM_IP} true 2>/dev/null && echo "SSH ready" && exit 0
                        echo "  attempt \$i/60..."
                        sleep 5
                    done
                    echo "ERROR: VM did not become reachable within 600 seconds"
                    exit 1
                """
            }
        }

        stage('Prepare disk') {
            steps {
                echo "Formatting PBS data disk with ext4..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
udevadm settle
ROOT_DISK=\$(lsblk -ndo PKNAME \$(findmnt -n -o SOURCE /) 2>/dev/null | head -1)
# Data disk = scsi1 via its stable by-id name: "first non-root disk" can hit a
# loop/zram swap device on Raspberry Pi OS, and this stage runs mkfs on it.
DATA_DEV=\$(readlink -f /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1)
[ -b "\${DATA_DEV}" ] || { echo "ERROR: scsi1 by-id not found"; ls -l /dev/disk/by-id/; lsblk; exit 1; }
DATA_DISK=\$(basename "\${DATA_DEV}")
[ "\${DATA_DISK}" != "\${ROOT_DISK}" ] || { echo "ERROR: scsi1 resolves to the root disk"; exit 1; }
echo "Root disk: /dev/\${ROOT_DISK}  Data disk: /dev/\${DATA_DISK}"
[ -z "\${DATA_DISK}" ] && { echo "ERROR: data disk not found"; lsblk; exit 1; }
systemctl stop mnt-pbs.mount 2>/dev/null || true
umount -f /mnt/pbs 2>/dev/null || true
umount -f /dev/\${DATA_DISK} 2>/dev/null || true
sleep 1
mkfs.ext4 -F -F -m 0 /dev/\${DATA_DISK}
ENDSSH
                """
            }
        }

        stage('Copy credentials') {
            steps {
                echo "Copying rclone.conf and restic-password from PVE host to CI VM..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} \
                        "mkdir -p /root/.config/rclone /etc/resticprofile"

                    ssh ${SSH_OPTS} root@${PVE_HOST} \
                        "cat /root/.config/rclone/rclone.conf" | \
                    ssh ${SSH_OPTS} root@${VM_IP} \
                        "cat > /root/.config/rclone/rclone.conf"

                    ssh ${SSH_OPTS} root@${PVE_HOST} \
                        "cat /etc/resticprofile/restic-password" | \
                    ssh ${SSH_OPTS} root@${VM_IP} \
                        "cat > /etc/resticprofile/restic-password"

                    ssh ${SSH_OPTS} root@${PVE_HOST} \
                        "cat /etc/resticprofile/config-encrypt-password" | \
                    ssh ${SSH_OPTS} root@${VM_IP} \
                        "cat > /etc/resticprofile/config-encrypt-password"
                """
            }
        }

        stage('Deploy scripts') {
            steps {
                echo "Copying proxmox_restore checkout to CI VM..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} "mkdir -p ${SCRIPTS_DIR}"
                    scp ${SSH_OPTS} -r \
                        ${WORKSPACE}/. \
                        root@${VM_IP}:${SCRIPTS_DIR}/
                """
            }
        }

        stage('Install PVE (restore-1-install.sh Step 0)') {
            steps {
                echo "Running restore-1-install.sh — Step 0 installs PVE (${params.PVE_ARM64_SOURCE}) and reboots..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH' || true
set -euo pipefail
cd ${SCRIPTS_DIR}
cp ci/config_ci_arm64.env config.env
CI=true PVE_ARM64_SOURCE=${params.PVE_ARM64_SOURCE} ROOT_PASSWORD="ci-arm64-root" bash restore-1-install.sh
ENDSSH
                """
                echo "VM is rebooting after PVE (${params.PVE_ARM64_SOURCE}) install. Waiting for SSH (max 150s)..."
                sh """
                    sleep 30
                    for i in \$(seq 1 24); do
                        ssh ${SSH_OPTS} root@${VM_IP} true 2>/dev/null && echo "SSH ready after reboot" && exit 0
                        echo "  attempt \$i/24..."
                        sleep 5
                    done
                    echo "ERROR: VM did not come back within 150 seconds"
                    exit 1
                """
            }
        }

        stage('Fix pve-cluster after reboot') {
            steps {
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
command -v pvesh &>/dev/null || { echo "ERROR: pvesh not found — pxvirt install failed in Step 0"; exit 1; }
# Assert only, do not repair. restore-1 must map the node name to its IP in a way that
# survives cloud-init's manage_etc_hosts (Pi Imager seed). Earlier this stage patched
# /etc/hosts itself, which hid a real DR bug (#307).
# CI instrumentation: a second authorized_keys outside /etc/pve, so a broken pve-cluster
# after a later reboot stays diagnosable instead of locking Jenkins out (#307/#309).
cat /root/.ssh/authorized_keys > /etc/ssh/ci_authorized_keys && chmod 600 /etc/ssh/ci_authorized_keys
echo 'AuthorizedKeysFile .ssh/authorized_keys /etc/ssh/ci_authorized_keys' > /etc/ssh/sshd_config.d/99-ci-fallback-keys.conf
sshd -t && systemctl reload ssh
for i in \$(seq 1 18); do systemctl is-active -q pve-cluster && break; sleep 5; done
if systemctl is-active -q pve-cluster; then echo "pve-cluster: OK"; else
    echo "ERROR: pve-cluster not active after reboot"; cat /etc/hosts; journalctl -u pve-cluster -n 20 --no-pager; exit 1
fi
ENDSSH
                """
            }
        }

        stage('Install tools (restore-1-install.sh Step 1+)') {
            steps {
                echo "Installing PBS (pipbs), rclone, restic, resticprofile..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
set -euo pipefail
cd ${SCRIPTS_DIR}
CI=true bash restore-1-install.sh
ENDSSH
                """
                script {
                    // restore-1-install.sh leaves a marker when it had to use the
                    // self-hosted PBS fallback (pipbs can't co-install with pxvirt's PVE).
                    // rc 3 = fallback in use (UNSTABLE), rc 1 = in use >30 days (FAIL).
                    def rc = sh(returnStatus: true, script: '''
                        FB=$(ssh $SSH_OPTS root@$VM_IP 'cat /root/.pbs-arm64-fallback 2>/dev/null' || true)
                        [ -z "$FB" ] && { echo "PBS installed from pipbs (no fallback)"; exit 0; }
                        SINCE=$(echo "$FB" | sed -n 's/^since=//p')
                        AGE=$(( ( $(date +%s) - $(date -d "$SINCE" +%s) ) / 86400 ))
                        echo "PBS ARM64 FALLBACK in use: $(echo "$FB" | tr '\\n' ' ')(${AGE} days)"
                        [ "$AGE" -gt 30 ] && { echo "Fallback active >30 days — check pxvirt/pipbs, bump or drop the fallback"; exit 1; }
                        exit 3
                    ''')
                    if (rc == 3) {
                        unstable('PBS installed from self-hosted arm64 fallback — pipbs latest cannot co-install with pxvirt PVE')
                    } else if (rc != 0) {
                        error('PBS arm64 fallback has been in use for more than 30 days')
                    }
                }
            }
        }

        stage('Install ShellSpec') {
            steps {
                echo "Installing ShellSpec on arm64 CI VM..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
set -euo pipefail
while fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock >/dev/null 2>&1; do echo "  Waiting for apt lock..."; sleep 5; done
apt-get install -y -q git
curl -fsSL https://git.io/shellspec | sh -s -- --yes --prefix /usr/local
shellspec --version
ENDSSH
                """
            }
        }

        stage('Restore pairing scenarios (restore-2, plan only)') {
            steps {
                echo "restore-2 corner cases end to end (real GDrive/decrypt/extract/restic list, no PBS restore)..."
                sh "ssh ${SSH_OPTS} root@${VM_IP} 'bash ${SCRIPTS_DIR}/ci/pairing-fixture.sh setup'"
                // a failing scenario fails the build, but the full DR below still runs
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    sh """
                        ssh ${SSH_OPTS} root@${VM_IP} \
                            'cd ${SCRIPTS_DIR} && /usr/local/bin/shellspec --shell bash --format junit ci/spec/restore_pairing_e2e_spec.sh' \
                            > shellspec-pairing-arm64.xml
                    """
                }
                // leave nothing behind that the real Path A restore below could pick up
                sh "ssh ${SSH_OPTS} root@${VM_IP} 'bash ${SCRIPTS_DIR}/ci/pairing-fixture.sh cleanup'"
            }
        }

        stage('Stage local config tar (simulate manual DR)') {
            steps {
                echo "Downloading arm64 config tar to /tmp/ then removing rclone.conf..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
set -euo pipefail
source ${SCRIPTS_DIR}/config.env
GDRIVE_CONFIG_PATH="\${RESTICPROFILE_GDRIVE_REMOTE}:bu/\${GDRIVE_CONFIG_FOLDER}"
# Only the encrypted format that backup-pve-config.sh writes today. Matching
# "*.tar.gz" picked a stale unencrypted 2026-03-27 leftover for months, so every
# DR run restored a March config instead of Scenario A's fresh backup.
LATEST=\$(rclone lsf "\${GDRIVE_CONFIG_PATH}/" --include "pve-config-*.tar.gz.enc" | sort -r | awk 'NR==1')
[ -z "\${LATEST}" ] && { echo "ERROR: no encrypted config backup found at \${GDRIVE_CONFIG_PATH}"; exit 1; }
LATEST_DATE="\${LATEST#pve-config-}"; LATEST_DATE="\${LATEST_DATE%%.tar.gz.enc}"
AGE_DAYS=\$(( ( \$(date -u +%s) - \$(date -u -d "\${LATEST_DATE}" +%s) ) / 86400 ))
if [ "\${AGE_DAYS}" -gt 2 ]; then
    echo "ERROR: newest config backup is \${LATEST} (\${AGE_DAYS} days old) — run Scenario A first; a DR test on stale data proves nothing"
    exit 1
fi
echo "Downloading \${LATEST} to /tmp/..."
rclone copy "\${GDRIVE_CONFIG_PATH}/\${LATEST}" /tmp/
echo "Removing rclone.conf to simulate fresh install..."
rm -f /root/.config/rclone/rclone.conf
echo "Staged: /tmp/\${LATEST}"
ENDSSH
                """
            }
        }

        stage('Restore from GDrive (restore-2-auth.sh)') {
            steps {
                echo "Restoring PBS datastore from Google Drive..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
set -euo pipefail
cd ${SCRIPTS_DIR}
CI=true bash restore-2-auth.sh
ENDSSH
                """
            }
        }

        stage('Configure PVE (restore-3-pve.sh)') {
            steps {
                echo "Wiring PBS storage into PVE, enabling schedules..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
set -euo pipefail
cd ${SCRIPTS_DIR}
CI=true bash restore-3-pve.sh
ENDSSH
                """
            }
        }

        stage('Restore LXC from PBS') {
            steps {
                echo "Restoring LXC 100 from PBS — full DR end-to-end..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} bash -s << 'ENDSSH'
set -euo pipefail
# Create vmbr0 bridge if missing (needed for LXC network config)
if ! ip link show vmbr0 &>/dev/null; then
    ip link add name vmbr0 type bridge 2>/dev/null || true
    ip link set vmbr0 up
fi
systemctl is-active --quiet pvedaemon || systemctl start pvedaemon pveproxy pvestatd
sleep 3

SNAP=\$(pvesh get /nodes/\$(hostname)/storage/pbs-ci/content --output-format json 2>/dev/null \
    | python3 -c "
import json, sys
items = json.load(sys.stdin)
ct = [x for x in items if x.get('vmid') == 100]
if not ct:
    raise SystemExit('ERROR: no backup for CT 100 in pbs-ci')
ct.sort(key=lambda x: x.get('ctime', 0))
print(ct[-1]['volid'])
")
echo "Restoring from: \${SNAP}"
rm -f /etc/pve/lxc/100.conf
pct restore 100 "\${SNAP}" --storage local
# Disable seccomp/apparmor — QEMU arm64 emulation blocks some syscalls
sed -i '/^net/d; /^lxc[.]seccomp/d; /^lxc[.]apparmor/d' /etc/pve/lxc/100.conf
echo "lxc.apparmor.profile: unconfined" >> /etc/pve/lxc/100.conf
pct start 100
sleep 5
ENDSSH
                """
            }
        }

        stage('Run ShellSpec (Scenario B / arm64)') {
            steps {
                echo "Running ShellSpec integration tests..."
                sh """
                    ssh ${SSH_OPTS} root@${VM_IP} \
                        'cd /opt/proxmox-restore && /usr/local/bin/shellspec --shell bash --format junit ci/spec/scenario_b_spec.sh ci/spec/restore_pair_spec.sh' \
                        > shellspec-b-arm64.xml
                """
            }
        }

            } // stages
        } // stage Run

    } // stages

    post {
        always {
            junit allowEmptyResults: true, testResults: 'shellspec-*-arm64.xml'

            echo "=== Cleanup ==="
            // pairing scratch folders on GDrive (setup also purges them, so a missed cleanup self-heals)
            sh "ssh ${SSH_OPTS} root@${VM_IP} 'bash ${SCRIPTS_DIR}/ci/pairing-fixture.sh cleanup' || true"
            sh """
                ssh ${SSH_OPTS} root@${PVE_HOST} \
                    "qm stop ${VM_ID} 2>/dev/null || true; sleep 5; qm destroy ${VM_ID} --purge 1" \
                    || true
            """
            echo "VM ${VM_ID} destroyed"
        }
        success {
            echo "ShellSpec arm64 DR pipeline PASSED — Scenario B verified on aarch64"
        }
        failure {
            echo "ShellSpec arm64 DR pipeline FAILED — check logs above"
        }
    }
}
